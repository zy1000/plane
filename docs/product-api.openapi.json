{
  "openapi": "3.0.3",
  "info": {
    "title": "Workspace Product API",
    "version": "1.4.0",
    "description": "工作区级产品、产品成员及产品角色 CRUD。产品负责人可从当前工作区活跃成员中添加产品成员并分配多个产品内角色；产品角色按产品隔离，仅产品负责人和工作区管理者可维护。"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "本地开发环境"
    }
  ],
  "tags": [
    {
      "name": "产品"
    },
    {
      "name": "产品成员"
    },
    {
      "name": "产品角色"
    }
  ],
  "paths": {
    "/api/workspaces/{slug}/products/": {
      "get": {
        "tags": ["产品"],
        "summary": "查询工作区产品列表",
        "operationId": "product_list",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceSlug" }],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Product" }
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["产品"],
        "summary": "创建产品",
        "description": "仅工作区管理员和成员可创建。owner 必须是当前工作区活跃成员，省略时默认为创建人；network 支持公开（2）和私有（0），省略时默认为公开。",
        "operationId": "product_create",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceSlug" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/workspaces/{slug}/products/{product_id}/": {
      "get": {
        "tags": ["产品"],
        "summary": "获取产品详情",
        "operationId": "product_retrieve",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["产品"],
        "summary": "完整更新产品",
        "description": "产品负责人、工作区管理员/所有者和实例管理员可更新，包括变更负责人和可见性。",
        "operationId": "product_update",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["产品"],
        "summary": "部分更新产品",
        "description": "产品负责人、工作区管理员/所有者和实例管理员可更新，包括变更负责人和可见性。",
        "operationId": "product_partial_update",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["产品"],
        "summary": "删除产品",
        "operationId": "product_delete",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "responses": {
          "204": { "description": "删除成功" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/workspaces/{slug}/products/{product_id}/members/": {
      "get": {
        "tags": ["产品成员"],
        "summary": "查询产品成员列表",
        "description": "返回当前产品的显式成员，支持按成员信息搜索及按成员、角色筛选。",
        "operationId": "product_member_list",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "按姓名、显示名称或邮箱模糊搜索"
          },
          {
            "name": "member_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "role_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ProductMember" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["产品成员"],
        "summary": "添加产品成员",
        "description": "仅产品负责人、工作区所有者、工作区管理员或实例管理员可操作。成员必须是当前工作区活跃成员，所选角色必须全部属于当前产品。",
        "operationId": "product_member_create",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductMemberCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "添加成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductMember" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MemberValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/workspaces/{slug}/products/{product_id}/members/{member_id}/": {
      "get": {
        "tags": ["产品成员"],
        "summary": "获取产品成员详情",
        "operationId": "product_member_retrieve",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/ProductMemberId" }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductMember" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/MemberNotFound" }
        }
      },
      "delete": {
        "tags": ["产品成员"],
        "summary": "移除产品成员",
        "description": "仅产品负责人和工作区管理者可操作；删除成员关系会同时解除其产品角色。",
        "operationId": "product_member_delete",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/ProductMemberId" }
        ],
        "responses": {
          "204": { "description": "移除成功，无响应体" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/MemberNotFound" }
        }
      }
    },
    "/api/workspaces/{slug}/products/{product_id}/members/{member_id}/custom-roles/": {
      "put": {
        "tags": ["产品成员"],
        "summary": "更新产品成员角色集合",
        "description": "使用角色 ID 数组替换成员的全部产品角色；空数组表示清空，所有角色必须属于当前产品。",
        "operationId": "product_member_custom_roles_update",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/ProductMemberId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductMemberCustomRolesUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductMember" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MemberValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/MemberNotFound" }
        }
      },
      "patch": {
        "tags": ["产品成员"],
        "summary": "更新产品成员角色集合",
        "operationId": "product_member_custom_roles_partial_update",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/ProductMemberId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductMemberCustomRolesUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductMember" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MemberValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/MemberNotFound" }
        }
      }
    },
    "/api/workspaces/{slug}/products/{product_id}/roles/": {
      "get": {
        "tags": ["产品角色"],
        "summary": "查询产品角色列表",
        "description": "仅产品负责人、工作区所有者、工作区管理员或实例管理员可访问，支持按角色名称或描述搜索。",
        "operationId": "product_role_list",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "按角色名称或描述模糊搜索",
            "schema": { "type": "string" },
            "example": "管理员"
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ProductRole" }
                },
                "example": [
                  {
                    "id": 1,
                    "product": "4fe5488d-b47f-45c9-a716-5b5b39875a2d",
                    "name": "产品管理员",
                    "description": "可管理产品配置",
                    "permissions": {},
                    "created_at": "2026-07-21T09:30:00Z",
                    "updated_at": "2026-07-21T09:30:00Z"
                  }
                ]
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["产品角色"],
        "summary": "创建产品角色",
        "description": "仅产品负责人、工作区所有者、工作区管理员或实例管理员可创建。角色名称在当前产品内唯一，权限固定初始化为空对象。",
        "operationId": "product_role_create",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductRoleCreate" },
              "example": {
                "name": "产品管理员",
                "description": "可管理产品配置"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductRole" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/RoleValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/workspaces/{slug}/products/{product_id}/roles/{role_id}/": {
      "get": {
        "tags": ["产品角色"],
        "summary": "获取产品角色详情",
        "description": "仅当前产品负责人和工作区管理者可访问；其他产品的角色返回 404。",
        "operationId": "product_role_retrieve",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/ProductRoleId" }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductRole" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/RoleNotFound" }
        }
      },
      "put": {
        "tags": ["产品角色"],
        "summary": "完整更新产品角色",
        "description": "仅当前产品负责人和工作区管理者可更新。permissions 为只读字段。",
        "operationId": "product_role_update",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/ProductRoleId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductRoleCreate" },
              "example": {
                "name": "高级产品管理员",
                "description": "可管理全部产品配置"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductRole" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/RoleValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/RoleNotFound" }
        }
      },
      "patch": {
        "tags": ["产品角色"],
        "summary": "部分更新产品角色",
        "description": "仅当前产品负责人和工作区管理者可更新。仅传入名称或描述，permissions 为只读字段。",
        "operationId": "product_role_partial_update",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/ProductRoleId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProductRoleUpdate" },
              "example": {
                "description": "更新后的角色描述"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProductRole" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/RoleValidationError" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/RoleNotFound" }
        }
      },
      "delete": {
        "tags": ["产品角色"],
        "summary": "删除产品角色",
        "description": "仅当前产品负责人和工作区管理者可删除。删除后仅移除该角色与成员的关联，不影响成员的其他产品角色。",
        "operationId": "product_role_delete",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceSlug" },
          { "$ref": "#/components/parameters/ProductId" },
          { "$ref": "#/components/parameters/ProductRoleId" }
        ],
        "responses": {
          "204": { "description": "删除成功，无响应体" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/RoleNotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "WorkspaceSlug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "description": "工作区标识",
        "schema": { "type": "string" },
        "example": "my-workspace"
      },
      "ProductId": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "description": "产品 ID",
        "schema": { "type": "string", "format": "uuid" }
      },
      "ProductRoleId": {
        "name": "role_id",
        "in": "path",
        "required": true,
        "description": "产品角色 ID",
        "schema": { "type": "integer", "format": "int32", "minimum": 1 },
        "example": 1
      },
      "ProductMemberId": {
        "name": "member_id",
        "in": "path",
        "required": true,
        "description": "产品成员关系 ID",
        "schema": { "type": "integer", "format": "int32", "minimum": 1 },
        "example": 10
      }
    },
    "schemas": {
      "UserLite": {
        "type": "object",
        "required": ["id", "display_name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "display_name": { "type": "string" },
          "avatar": { "type": "string", "nullable": true },
          "avatar_url": { "type": "string", "nullable": true },
          "is_bot": { "type": "boolean" }
        }
      },
      "ProductCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 255 },
          "description_html": {
            "type": "string",
            "nullable": true,
            "description": "服务端清洗后的编辑器 HTML"
          },
          "network": {
            "type": "integer",
            "enum": [0, 2],
            "description": "0 为私有，2 为公开"
          },
          "owner": {
            "type": "string",
            "format": "uuid",
            "description": "当前工作区活跃成员 ID"
          },
          "reviewers": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "description": "必须全部为当前工作区的活跃成员"
          }
        }
      },
      "ProductUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 255 },
          "description_html": {
            "type": "string",
            "nullable": true,
            "description": "服务端清洗后的编辑器 HTML"
          },
          "network": {
            "type": "integer",
            "enum": [0, 2],
            "description": "0 为私有，2 为公开"
          },
          "owner": {
            "type": "string",
            "format": "uuid",
            "description": "当前工作区活跃成员 ID"
          },
          "reviewers": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" },
            "description": "必须全部为当前工作区的活跃成员"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "network",
          "workspace",
          "owner",
          "reviewers",
          "owner_detail",
          "reviewer_details",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description_html": { "type": "string", "nullable": true },
          "network": { "type": "integer", "enum": [0, 2] },
          "workspace": { "type": "string", "format": "uuid" },
          "owner": { "type": "string", "format": "uuid" },
          "reviewers": {
            "type": "array",
            "items": { "type": "string", "format": "uuid" }
          },
          "owner_detail": { "$ref": "#/components/schemas/UserLite" },
          "reviewer_details": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UserLite" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "created_by": { "type": "string", "format": "uuid", "nullable": true },
          "updated_by": { "type": "string", "format": "uuid", "nullable": true }
        }
      },
      "ProductMemberCreate": {
        "type": "object",
        "required": ["member"],
        "properties": {
          "member": {
            "type": "string",
            "format": "uuid",
            "description": "当前工作区活跃成员的用户 ID"
          },
          "custom_role_ids": {
            "type": "array",
            "items": { "type": "integer", "format": "int32" },
            "description": "当前产品的角色 ID 列表；省略或空数组表示未分配角色"
          }
        }
      },
      "ProductMemberCustomRolesUpdate": {
        "type": "object",
        "required": ["custom_role_ids"],
        "properties": {
          "custom_role_ids": {
            "type": "array",
            "items": { "type": "integer", "format": "int32" },
            "description": "替换后的产品角色 ID 列表；空数组表示清空角色"
          }
        }
      },
      "ProductMember": {
        "type": "object",
        "required": [
          "id",
          "product",
          "member",
          "custom_role_ids",
          "member_detail",
          "role_details",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "integer", "format": "int32" },
          "product": { "type": "string", "format": "uuid" },
          "member": { "type": "string", "format": "uuid" },
          "custom_role_ids": {
            "type": "array",
            "items": { "type": "integer", "format": "int32" }
          },
          "member_detail": { "$ref": "#/components/schemas/UserLite" },
          "role_details": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProductRole" }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ProductRoleCreate": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "当前产品内唯一的角色名称，服务端会移除首尾空白",
            "example": "产品管理员"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "可管理产品配置"
          }
        }
      },
      "ProductRoleUpdate": {
        "type": "object",
        "description": "部分更新时所有字段均可选",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "example": "高级产品管理员"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "更新后的角色描述"
          }
        }
      },
      "ProductRole": {
        "type": "object",
        "required": ["id", "product", "name", "permissions", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "integer", "format": "int32", "example": 1 },
          "product": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "example": "产品管理员" },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "可管理产品配置"
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "readOnly": true,
            "example": {}
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "参数校验失败"
      },
      "Forbidden": {
        "description": "无权限",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "产品不存在",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "RoleValidationError": {
        "description": "角色参数校验失败",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "examples": {
              "duplicateName": {
                "summary": "角色名称重复",
                "value": {
                  "name": ["Product role name already exists."]
                }
              }
            }
          }
        }
      },
      "MemberValidationError": {
        "description": "产品成员或角色归属校验失败",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "MemberNotFound": {
        "description": "产品成员不存在或不属于当前产品",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Product member not found." }
          }
        }
      },
      "Unauthorized": {
        "description": "未认证或 API Key 无效",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "RoleNotFound": {
        "description": "产品角色不存在",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "Product role not found." }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "个人或服务 API Key"
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid",
        "description": "浏览器 Session Cookie"
      }
    }
  },
  "security": [{ "apiKeyAuth": [] }, { "sessionAuth": [] }]
}
