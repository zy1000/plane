# =====================================================================
# Plane docker compose 部署配置（根目录 docker-compose.yml 读取）
#
# 用法：cp .env.example .env，改完「一、必填」再 docker compose up -d
#
# 规则：
# - 某项留空或删掉 = 用 docker-compose.yml 里的默认值。
#   密码类留空就是默认弱密码（plane / secret-key），正式部署务必填。
# - 密码只用字母和数字：RabbitMQ 密码会拼进连接地址，@ : / # 会把地址弄坏，
#   $ 会被 compose 当成变量。生成：openssl rand -hex 24
# - 只有 docker-compose.yml 里引用到的变量才会传进容器，这里多写别的没有用。
# - 标「构建时」的项会写进前端镜像，改了要重新 build。
#
# docker-compose.dev.yml（开发栈）用的是根目录 dev.env，不读这个文件。
# =====================================================================


# ---------------------------------------------------------------------
# 一、必填
# ---------------------------------------------------------------------

# 对外访问地址，逗号分隔，非 80 端口要带端口号；没填 compose 会拒绝启动。
# 第一个是默认地址（定时提醒等拿不到访问地址时用）；不在清单里的地址一律不认。
# 也可用 ./scripts/build-for-host.sh 写入。
CORS_ALLOWED_ORIGINS="http://10.32.232.104,http://192.168.100.104"

# Django 密钥，同时用来加密实例配置。
# 从旧服务器搬数据时必须和旧服务器一致，否则后台配置解不开；
# 旧服务器没设过就是 compose 默认值 change-me-to-a-long-random-string。
SECRET_KEY=""

# api 和 live 之间的通信密钥，填一串随机值即可
LIVE_SERVER_SECRET_KEY=""

# 数据库密码。只在数据目录第一次初始化时生效，之后要改得进库执行 ALTER USER
POSTGRES_PASSWORD=""

# 消息队列密码。同样只在 MQ 数据目录第一次初始化时生效
RABBITMQ_PASSWORD=""

# 文件存储账号，同时是 MinIO 管理员账号（账号至少 3 位，密码至少 8 位）
AWS_ACCESS_KEY_ID="plane-minio"
AWS_SECRET_ACCESS_KEY=""


# ---------------------------------------------------------------------
# 二、端口
# ---------------------------------------------------------------------

# 对外 HTTP 端口
LISTEN_HTTP_PORT=80
# nginx 目前只监听 80，这个映射用不上；宿主机 443 被占用时改成别的空闲端口
LISTEN_HTTPS_PORT=443

# compose 内部网段。和服务器现有网段冲突时才改；
# 改了要同步改「九」里的 TRUSTED_PROXY_CIDRS，让它包含新网段
# PLANE_NETWORK_SUBNET="172.29.0.0/24"


# ---------------------------------------------------------------------
# 三、数据库 / 缓存 / 消息队列（compose 内网服务，一般不改）
# ---------------------------------------------------------------------

POSTGRES_USER="plane"
POSTGRES_DB="plane"
# POSTGRES_HOST="plane-db"
# POSTGRES_PORT=5432
# PGDATA="/var/lib/postgresql/data"

# REDIS_URL="redis://plane-redis:6379/0"

RABBITMQ_USER="plane"
RABBITMQ_VHOST="plane"
# RABBITMQ_HOST="plane-mq"
# RABBITMQ_PORT=5672


# ---------------------------------------------------------------------
# 四、文件存储
# ---------------------------------------------------------------------

# 桶名，nginx 的转发规则会自动跟着用
AWS_S3_BUCKET_NAME="uploads"
# 单个文件上传上限（字节），nginx 也用这个值。104857600 = 100MB
FILE_SIZE_LIMIT=104857600
# 下载链接有效期（秒）
SIGNED_URL_EXPIRATION=3600
# 前面还有一层 HTTPS 反向代理时改成 1，让文件地址走 https
MINIO_ENDPOINT_SSL=0

# 改用外部 S3 时才需要动下面几项
# USE_MINIO=1
# AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# AWS_REGION=""


# ---------------------------------------------------------------------
# 五、应用
# ---------------------------------------------------------------------

DEBUG=0
# 接口进程数，一般按 CPU 核数设（内存紧张就少一点）
GUNICORN_WORKERS=2
ALLOWED_HOSTS="*"
# 个人 API Key 调用频率上限
API_KEY_RATE_LIMIT="60/minute"


# ---------------------------------------------------------------------
# 六、OnlyOffice 文档预览（随 compose 一起起，经 nginx 挂在 /onlyoffice/，一般不改）
# ---------------------------------------------------------------------

# ONLYOFFICE_DOCUMENT_SERVER_URL="/onlyoffice"
# ONLYOFFICE_INTERNAL_URL="http://onlyoffice"
# ONLYOFFICE_API_BASE_URL="http://api:8000"
# compose 里的 onlyoffice 容器固定关了 JWT，这里要开得两边一起改
# ONLYOFFICE_JWT_ENABLED=0
# ONLYOFFICE_JWT_SECRET=""
# ONLYOFFICE_JWT_HEADER="AuthorizationJwt"
# ONLYOFFICE_SESSION_TTL_SECONDS=28800


# ---------------------------------------------------------------------
# 七、简道云（经公司网关）
# ---------------------------------------------------------------------

# token 和 appkey 都填了才启用。网关域名的 8045 不通时可临时换成 10.32.232.60:8045
JIANDAOYUN_API_BASE_URL="http://gw-api.kaifametering.com:8045/gw/API-JDY/240619036"
JIANDAOYUN_API_TOKEN=""
JIANDAOYUN_APP_KEY=""
JIANDAOYUN_TIMEOUT_SECONDS=30

# 项目代号表
JIANDAOYUN_PROJECT_CODE_APP_ID="657a49dcf6c33a0afc296a05"
JIANDAOYUN_PROJECT_CODE_ENTRY_ID="657a4a502b07762f1a4a374c"
# 研发项目表
JIANDAOYUN_RD_PROJECT_APP_ID="657a49dcf6c33a0afc296a05"
JIANDAOYUN_RD_PROJECT_ENTRY_ID="657a4a552b07762f1a4a3760"
# 风险表
JIANDAOYUN_RISK_APP_ID="657a49dcf6c33a0afc296a05"
JIANDAOYUN_RISK_ENTRY_ID="685e30c70e4a757f43bc9ef4"

# 风险单回写简道云：三个写地址都填了才会推送。
# 简道云只有一张正式表单，只能有一个环境（正式环境）填，测试环境保持注释。
# JIANDAOYUN_API_CREATE_BASE_URL="http://gw-api.kaifametering.com:8045/gw/API-JDY/240619037"
# JIANDAOYUN_API_UPDATE_BASE_URL="http://gw-api.kaifametering.com:8045/gw/API-JDY/240619043"
# JIANDAOYUN_API_DELETE_BASE_URL="http://gw-api.kaifametering.com:8045/gw/API-JDY/240619045"
# 简道云「数据推送」设置页生成的签名密钥；为空时拒收简道云的推送
JIANDAOYUN_RISK_PUSH_SECRET=""


# ---------------------------------------------------------------------
# 八、人员信息（MDM）
# ---------------------------------------------------------------------

PERSON_INFO_API_URL="http://gw-api.kaifametering.com:8045/gw/lc-mdm/v1/get/person_info"
PERSON_INFO_APP_KEY=""


# ---------------------------------------------------------------------
# 九、大网 / 小网隔离（按客户端 IP 判网段）
# ---------------------------------------------------------------------

NETWORK_ZONE_ENABLED=0
NETWORK_ZONE_WAN_CIDRS="10.0.0.0/8"
NETWORK_ZONE_LAN_CIDRS="192.168.0.0/16"
# 大网 / 小网各自的地址，默认按 IP 从 CORS_ALLOWED_ORIGINS 里自动认；
# 用域名（看不出网段）时才取消注释手动填
# NETWORK_ZONE_WAN_WEB_URL="https://pms.example.com"
# NETWORK_ZONE_LAN_WEB_URL="http://192.168.100.104"
# 只信任这些来源转发的客户端 IP（默认已包含 compose 内网）
# TRUSTED_PROXY_CIDRS="127.0.0.0/8,::1/128,172.16.0.0/12"


# ---------------------------------------------------------------------
# 十、前端（构建时，改了要重新 build web / admin / space）
# ---------------------------------------------------------------------

VITE_SUPPORT_EMAIL="support@example.com"
# DOCS_BASE_PATH="/docs"

# 以下地址留空即可，不要填（前端走相对路径，一套镜像多个地址通用）：
# WEB_URL、APP_BASE_URL、ADMIN_BASE_URL、SPACE_BASE_URL、LIVE_BASE_URL、
# VITE_API_BASE_URL、VITE_WEB_BASE_URL、VITE_ADMIN_BASE_URL、VITE_SPACE_BASE_URL、
# VITE_LIVE_BASE_URL、VITE_WEBSITE_URL、DOCS_BASE_URL
