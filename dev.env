VITE_ADMIN_BASE_PATH=/god-mode
VITE_SPACE_BASE_URL=http://10.32.190.212:3002
VITE_SPACE_BASE_PATH=/spaces
VITE_LIVE_BASE_URL=http://10.32.190.212:3003
