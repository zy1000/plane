# 开发环境（docker-compose.dev.yml）变量：与 compose 变量替换配合使用。
# 启动：pnpm docker:dev
# 或：docker compose --env-file dev.env -f docker-compose.dev.yml up --build
#
# 公网访问地址（写死）

DEV_PUBLIC_HOST=10.32.190.212
DEV_BIND_ADDRESS=0.0.0.0

DEBUG=1
ALLOWED_HOSTS=*

SECRET_KEY=change-me-to-a-long-random-string
LIVE_SERVER_SECRET_KEY=change-me-live-secret

WEB_URL=http://10.32.190.212:3000
APP_BASE_URL=http://10.32.190.212:3000
APP_BASE_PATH=
ADMIN_BASE_URL=http://10.32.190.212:3001
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=http://10.32.190.212:3002
SPACE_BASE_PATH=/spaces
LIVE_BASE_URL=http://10.32.190.212:3003
LIVE_BASE_PATH=/live

# 浏览器 + 本机回环，便于宿主机本地调试
CORS_ALLOWED_ORIGINS=http://10.32.190.212:3000,http://10.32.190.212:3001,http://10.32.190.212:3002,http://10.32.190.212:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

ONLYOFFICE_DOCUMENT_SERVER_URL=http://10.32.190.212:89
ONLYOFFICE_API_BASE_URL=http://10.32.190.212:8000
ONLYOFFICE_SESSION_TTL_SECONDS=28800

# 简道云（经公司网关）：项目代号等第三方数据来源；token / appkey 都填了才启用。requests 会自动读 HTTP_PROXY / HTTPS_PROXY
# 网关走域名 gw-api.kaifametering.com:8045；若所在网段到 8045 不通，可临时换成内网地址 10.32.232.60:8045
JIANDAOYUN_API_BASE_URL=http://gw-api.kaifametering.com:8045/gw/API-JDY/240619036
JIANDAOYUN_API_TOKEN=
JIANDAOYUN_APP_KEY=
JIANDAOYUN_PROJECT_CODE_APP_ID=657a49dcf6c33a0afc296a05
JIANDAOYUN_PROJECT_CODE_ENTRY_ID=657a4a502b07762f1a4a374c
JIANDAOYUN_TIMEOUT_SECONDS=30

# 前端 Vite（浏览器内请求，须为可访问到宿主机的地址）
VITE_API_BASE_URL=http://10.32.190.212:8000
VITE_API_BASE_PATH=/api
VITE_WEB_BASE_URL=http://10.32.190.212:3000
VITE_WEB_BASE_PATH=
