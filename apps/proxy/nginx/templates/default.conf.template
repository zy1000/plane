# 与 Caddyfile.ce 等价的 HTTP 反代（不含 TLS）。
# 需通过环境变量传入：FILE_SIZE_LIMIT（字节）、BUCKET_NAME（与 docker-compose 中一致，默认 uploads）。

server {
    listen 80;
    server_name _;

    client_max_body_size ${FILE_SIZE_LIMIT};
    # Caddy 侧 max_header_size 较大；此处放宽请求行+头缓冲（按需再调）
    large_client_header_buffers 8 64k;

    location = /spaces {
        return 301 /spaces/;
    }

    location = /docs {
        return 301 /docs/;
    }

    location ^~ /docs/ {
        proxy_pass http://docs:80/;
        include /etc/nginx/proxy_params.plane;
    }

    location ^~ /spaces/ {
        proxy_pass http://space:3000;
        include /etc/nginx/proxy_params.plane;
    }

    location = /god-mode {
        return 301 /god-mode/;
    }

    location ^~ /god-mode/ {
        proxy_pass http://admin:3000;
        include /etc/nginx/proxy_params.plane;
    }

    location ^~ /live/ {
        proxy_pass http://live:3000;
        include /etc/nginx/proxy_params.plane;
    }

    location ^~ /api/ {
        proxy_pass http://api:8000;
        include /etc/nginx/proxy_params.plane;
    }

    location ^~ /auth/ {
        proxy_pass http://api:8000;
        include /etc/nginx/proxy_params.plane;
    }

    location ^~ /static/ {
        proxy_pass http://api:8000;
        include /etc/nginx/proxy_params.plane;
    }

    # MinIO 路径风格：/{bucket}/...
    location ^~ /${BUCKET_NAME}/ {
        proxy_pass http://plane-minio:9000;
        include /etc/nginx/proxy_params.plane;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location = /${BUCKET_NAME} {
        proxy_pass http://plane-minio:9000;
        include /etc/nginx/proxy_params.plane;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://web:3000;
        include /etc/nginx/proxy_params.plane;
    }
}
