# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
SECRET_KEY="change-me-to-a-long-random-string"
ALLOWED_HOSTS="*"
CORS_ALLOWED_ORIGINS="http://127.0.0.1"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://plane:plane@plane-db:5432/plane"

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_URL="redis://plane-redis:6379/0"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=104857600
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=1

# Replace 127.0.0.1 with your server IP or domain when deploying.
WEB_URL="http://127.0.0.1"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://127.0.0.1"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://127.0.0.1"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://127.0.0.1"
APP_BASE_PATH=""

LIVE_BASE_URL="http://127.0.0.1"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="change-me-live-secret"
ONLYOFFICE_DOCUMENT_SERVER_URL="http://127.0.0.1:89"
ONLYOFFICE_API_BASE_URL="http://127.0.0.1:8000"
ONLYOFFICE_JWT_ENABLED=0
ONLYOFFICE_JWT_SECRET=""
ONLYOFFICE_JWT_HEADER="AuthorizationJwt"
ONLYOFFICE_SESSION_TTL_SECONDS=28800

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# 简道云（经公司网关）：项目代号等第三方数据来源；token / appkey 都填了才启用。requests 会自动读 HTTP_PROXY / HTTPS_PROXY
# 网关走域名 gw-api.kaifametering.com:8045；若所在网段到 8045 不通，可临时换成内网地址 10.32.232.60:8045
JIANDAOYUN_API_BASE_URL="http://gw-api.kaifametering.com:8045/gw/API-JDY/240619036"
JIANDAOYUN_API_TOKEN=""
JIANDAOYUN_APP_KEY=""
JIANDAOYUN_PROJECT_CODE_APP_ID="657a49dcf6c33a0afc296a05"
JIANDAOYUN_PROJECT_CODE_ENTRY_ID="657a4a502b07762f1a4a374c"
JIANDAOYUN_TIMEOUT_SECONDS=30
